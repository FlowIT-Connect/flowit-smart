# Boîtier vidéo Solea (docker-compose.video.yml) — copiez en .env et complétez.
SUPABASE_URL=https://VOTRE-PROJET.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Intégration du boîtier : dans Solea, Paramètres › Intégrations › Ajouter › « Autre » (un par logement)
INTEGRATION_ID=

ADAPTER=video

# Sous-réseaux où la recherche ONVIF est permise (par défaut : réseaux privés 10/8, 172.16/12, 192.168/16)
# VIDEO_SUBNETS=192.168.1.0/24
# VIDEO_DISCOVERY=true

# Vidéo hors du domicile : STUN public par défaut. Pour les réseaux mobiles stricts, ajoutez le
# relais TURN de l'exploitant (coturn avec « use-auth-secret ») : le secret reste ici, l'application
# ne reçoit que des identifiants valables 6 heures.
# VIDEO_STUN_URLS=stun:stun.l.google.com:19302
# VIDEO_TURN_URLS=turn:turn.solea-dz.com:3478,turns:turn.solea-dz.com:5349
# VIDEO_TURN_SECRET=

# Relais vidéo local (MediaMTX). MEDIAMTX=false : images fixes seulement.
# MEDIAMTX=true
# MEDIAMTX_API_URL=http://127.0.0.1:9997
# MEDIAMTX_WEBRTC_URL=http://127.0.0.1:8889

# Automatisations : le boîtier exécute celles déclenchées par SES appareils (mouvement d'une
# caméra…). Les déclencheurs horaires restent à la passerelle principale du logement.
# RUN_TIME_TRIGGERS=false
LOG_LEVEL=info
