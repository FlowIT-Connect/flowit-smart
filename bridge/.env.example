# FlowIT Bridge — copiez ce fichier en .env (jamais versionné) et complétez.

# Projet Supabase (Project Settings > API). La clé service_role reste sur cette machine uniquement.
SUPABASE_URL=https://VOTRE-PROJET.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Identifiant affiché dans l'application : Paramètres > Intégrations > (votre intégration)
INTEGRATION_ID=

# home_assistant (avec une box), tuya_cloud (Tuya / Smart Life sans box), simulator (appareils fictifs)
# ou video (boîtier vidéo : voir .env.video.example et docs/INTERPHONIE_VIDEO.md)
ADAPTER=home_assistant

# Home Assistant sur le réseau local (ne pas l'exposer à Internet).
# Jeton : profil utilisateur HA > Sécurité > Jetons d'accès longue durée (compte dédié recommandé).
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# Tuya Cloud (ADAPTER=tuya_cloud) : platform.tuya.com > Cloud > votre projet > Overview.
# Le plus simple : « npm run configurer » remplit ce fichier pour vous.
# TUYA_ACCESS_ID=
# TUYA_ACCESS_SECRET=
# Data center : eu (Central Europe), weu, us, eus, cn, in
# TUYA_REGION=eu
# TUYA_POLL_SECONDS=30

# Facultatif : n'importer que certaines entités (expression régulière sur entity_id)
# HA_ENTITY_FILTER=^(light|switch|cover|climate|sensor|binary_sensor)\.

# Caméras IP lues directement par la passerelle, sans Home Assistant (la passerelle doit être
# sur le même réseau que les caméras). Une caméra par « Nom=adresse de l'image », séparées par « ; ».
# Exemples d'adresse : Hikvision http://admin:MOTDEPASSE@192.168.1.20/ISAPI/Streaming/channels/101/picture
#                      Dahua / Imou http://admin:MOTDEPASSE@192.168.1.21/cgi-bin/snapshot.cgi
# (authentification « Basic » ; avec Home Assistant, ajoutez plutôt la caméra dans HA)
# CAMERAS=Entrée=http://admin:MOTDEPASSE@192.168.1.20/snapshot.jpg;Garage=http://192.168.1.21/snap.jpg
# Intervalle entre deux images pendant qu'un membre regarde (ms)
# CAMERA_INTERVAL_MS=1000

# Serrures et contrôles d'accès TTLock (facultatif, avec n'importe quel ADAPTER).
# Clés de l'application créée sur open.ttlock.com + compte de l'app TTLock qui gère la serrure.
# Le mot de passe s'écrit en MD5 (« npm run configurer » le calcule pour vous).
# Sans passerelle TTLock G2/G3 : codes d'accès, batterie et historique ; avec : ouverture à distance.
# TTLOCK_CLIENT_ID=
# TTLOCK_CLIENT_SECRET=
# TTLOCK_USERNAME=
# TTLOCK_PASSWORD_MD5=
# TTLOCK_API_URL=https://euapi.ttlock.com
# TTLOCK_POLL_SECONDS=300

# Caméras et visiophones ONVIF / RTSP avec vidéo fluide (boîtier sur place) : VIDEO=true,
# voir .env.video.example. Jamais avec PLATFORM=true.
# VIDEO=true

# Délais (ms)
COMMAND_TIMEOUT_MS=10000
PENDING_MAX_AGE_MS=30000
POLL_INTERVAL_MS=2000

# Une seule passerelle par maison doit exécuter les automatisations
RUN_AUTOMATIONS=true
LOG_LEVEL=info
