# FlowIT Bridge — copiez ce fichier en .env (jamais versionné) et complétez.

# Projet Supabase (Project Settings > API). La clé service_role reste sur cette machine uniquement.
SUPABASE_URL=https://VOTRE-PROJET.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Identifiant affiché dans l'application : Paramètres > Intégrations > (votre intégration)
INTEGRATION_ID=

# home_assistant (production) ou simulator (appareils fictifs, sans matériel)
ADAPTER=home_assistant

# Home Assistant sur le réseau local (ne pas l'exposer à Internet).
# Jeton : profil utilisateur HA > Sécurité > Jetons d'accès longue durée (compte dédié recommandé).
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# Facultatif : n'importer que certaines entités (expression régulière sur entity_id)
# HA_ENTITY_FILTER=^(light|switch|cover|climate|sensor|binary_sensor)\.

# Délais (ms)
COMMAND_TIMEOUT_MS=10000
PENDING_MAX_AGE_MS=30000
POLL_INTERVAL_MS=2000

# Une seule passerelle par maison doit exécuter les automatisations
RUN_AUTOMATIONS=true
LOG_LEVEL=info
