# Publication de Solea sur les stores, lancée par .github/workflows/publier-stores.yml.
# Les secrets arrivent par variables d'environnement (secrets GitHub), jamais dans ce fichier.
# Guide : docs/PUBLIER_SUR_LES_STORES.md

opt_out_usage

def env!(name)
  value = ENV[name].to_s
  UI.user_error!("Secret GitHub manquant : #{name} (voir docs/PUBLIER_SUR_LES_STORES.md)") if value.empty?
  value
end

def upload_metadata?
  ENV["UPLOAD_METADATA"] == "true"
end

platform :android do
  desc "Envoie le fichier .aab sur Google Play (piste interne par défaut)"
  lane :deploy do
    upload_to_play_store(
      json_key_data: env!("PLAY_SERVICE_ACCOUNT_JSON"),
      aab: "build/app/outputs/bundle/release/app-release.aab",
      track: ENV.fetch("PLAY_TRACK", "internal"),
      # Tant que l'app n'a jamais été publiée, Google n'accepte que des versions « draft ».
      release_status: ENV.fetch("PLAY_RELEASE_STATUS", "draft"),
      metadata_path: "fastlane/metadata/android",
      skip_upload_metadata: !upload_metadata?,
      skip_upload_changelogs: !upload_metadata?,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end

platform :ios do
  desc "Signe l'app, la compile et l'envoie sur TestFlight"
  lane :deploy do
    setup_ci
    api_key = app_store_connect_api_key(
      key_id: env!("ASC_KEY_ID"),
      issuer_id: env!("ASC_ISSUER_ID"),
      key_content: env!("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true
    )
    bundle_id = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)

    # Certificat et profil de distribution, gardés chiffrés dans un dépôt privé (fastlane match).
    match(
      type: "appstore",
      api_key: api_key,
      git_url: env!("MATCH_GIT_URL"),
      git_basic_authorization: env!("MATCH_GIT_BASIC_AUTHORIZATION"),
      team_id: env!("APPLE_TEAM_ID"),
      readonly: ENV["MATCH_READONLY"] == "true"
    )

    update_code_signing_settings(
      path: "ios/Runner.xcodeproj",
      targets: ["Runner"],
      use_automatic_signing: false,
      team_id: ENV["APPLE_TEAM_ID"],
      code_sign_identity: ENV["sigh_#{bundle_id}_appstore_certificate-name"],
      profile_name: ENV["sigh_#{bundle_id}_appstore_profile-name"]
    )

    build_app(
      workspace: "ios/Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/ios/fastlane",
      output_name: "Solea.ipa"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )

    if upload_metadata?
      upload_to_app_store(
        api_key: api_key,
        skip_binary_upload: true,
        skip_screenshots: true,
        metadata_path: "fastlane/metadata/ios",
        force: true,
        precheck_include_in_app_purchases: false
      )
    end
  end
end
