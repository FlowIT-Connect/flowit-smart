# Adresse publique du site (sans / final) : sert aux liens canoniques, hreflang et sitemap.
SITE_URL=https://solea-dz.com

# Projet Supabase DÉDIÉ au site (pas celui de l'app). Clé publique « publishable » seulement.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Base de géolocalisation IP (DB-IP Lite Country, format .mmdb). Facultatif :
# sans elle, le pays est déduit des en-têtes du proxy ou de la langue du navigateur.
GEOIP_DB=./data/dbip-country-lite.mmdb
